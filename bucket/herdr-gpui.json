{
    "version": "20261102.2",
    "description": "Desktop interface for the Herdr daemon",
    "homepage": "https://github.com/penso/herdr-gpui",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/penso/herdr-gpui/releases/download/v20261102.2/Herdr-20261102.2-x86_64-pc-windows-msvc.zip",
            "hash": "1f983220d8159f92e5d75778b598a5df86261ed858ea810a52315946f1c0674d",
            "extract_dir": "Herdr-20261102.2-x86_64-pc-windows-msvc"
        },
        "arm64": {
            "url": "https://github.com/penso/herdr-gpui/releases/download/v20261102.2/Herdr-20261102.2-aarch64-pc-windows-msvc.zip",
            "hash": "a8bb4ceda062cd095b3ebb890cd3db3dcdb906bbb0d36b3ba6fdbab9528ae82d",
            "extract_dir": "Herdr-20261102.2-aarch64-pc-windows-msvc"
        }
    },
    "depends": "rcedit",
    "pre_install": [
        "$bucketDir = if ($bucket) { Find-BucketDirectory $bucket -Root } else { Split-Path (Split-Path $url) }",
        "Copy-Item \"$bucketDir\\scripts\\herdr-gpui\" \"$dir\\icons\" -Recurse",
        "# Avoid Scoop treating system conhost as a competing app when replacing Herdr's own shim.",
        "$shim = \"$(shimdir $global)\\herdr-gpui.shim\"",
        "if ((get_app_name_from_shim $shim) -eq 'herdr-gpui') { Remove-Item $shim }"
    ],
    "bin": [["conhost.exe", "herdr-gpui", "--headless \"$dir\\herdr-gpui.exe\""]],
    "shortcuts": [["..\\..\\..\\shims\\herdr-gpui.exe", "Herdr", "", "icons\\herdr.ico"]],
    "post_install": [
        "rcedit \"$(shimdir $global)\\herdr-gpui.exe\" --set-icon \"$dir\\icons\\herdr.ico\"",
        "if ($LASTEXITCODE -ne 0) { throw 'Failed to set Herdr shim icon' }"
    ],
    "notes": "Experimental, unsigned Windows GUI build. Requires an existing Herdr daemon."
}
